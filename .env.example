# Pipedrive
PIPEDRIVE_API_TOKEN=seu_token_aqui

# Google Sheets
GOOGLE_SHEET_ID=id_da_sua_planilha_aqui
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Configurações
TIMEZONE=America/Sao_Paulo
RESET_HOUR=8

# Segurança (opcional mas recomendado)
# Gere uma string aleatória: https://generate-secret.vercel.app/32
CRON_SECRET=sua_string_secreta_aqui
