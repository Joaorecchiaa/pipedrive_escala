# Pipedrive
PIPEDRIVE_API_TOKEN=seu_token_aqui

# Google Sheets
GOOGLE_SHEET_ID=id_da_sua_planilha_aqui
# Cole o conteúdo JSON da sua Service Account abaixo (em uma linha só, sem quebras)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Configurações
TIMEZONE=America/Sao_Paulo
# Horário de reset diário (limpeza das equipes + início da escala)
RESET_HOUR=8
